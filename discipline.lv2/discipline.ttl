@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix options: <http://lv2plug.in/ns/ext/options#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix bufsz: <http://lv2plug.in/ns/ext/buf-size#> .

<https://github.com/ABustos2606/discipline#discipline>
    a lv2:Plugin, lv2:DelayPlugin ;
    doap:name "Discipline" ;
    doap:license <https://spdx.org/licenses/MIT> ;
    doap:maintainer [ foaf:name "Alejandro Bustos" ; foaf:homepage <https://github.com/ABustos2606> ] ;
    doap:homepage <https://github.com/ABustos2606/discipline> ;
    rdfs:comment "Delay with a 3-minute memory. Cable Send to a Discipline Return through any modules. Size sets echo time; Routing sets where the return feeds back." ;
    lv2:minorVersion 2 ;
    lv2:microVersion 0 ;
    lv2:optionalFeature lv2:hardRTCapable, options:options ;
    options:supportedOption bufsz:nominalBlockLength, bufsz:maxBlockLength ;
    lv2:requiredFeature urid:map ;
    lv2:port
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "In L"
    ],
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "In R"
    ],
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Out L"
    ],
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Out R"
    ],
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 4 ;
        lv2:symbol "send_l" ;
        lv2:name "Send L"
    ],
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 5 ;
        lv2:symbol "send_r" ;
        lv2:name "Send R"
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "level" ;
        lv2:name "Level" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.5
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "repeats" ;
        lv2:name "Repeats" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.4
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "size" ;
        lv2:name "Size" ;
        lv2:minimum 50 ;
        lv2:maximum 60000 ;
        lv2:default 500 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit units:ms
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "size_beats" ;
        lv2:name "Size beats" ;
        lv2:minimum 0.125 ;
        lv2:maximum 128 ;
        lv2:default 1 ;
        units:unit units:beat
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "sync" ;
        lv2:name "Sync" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty lv2:toggled
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "bpm" ;
        lv2:name "BPM" ;
        lv2:minimum 30 ;
        lv2:maximum 300 ;
        lv2:default 120 ;
        units:unit units:bpm
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "spread" ;
        lv2:name "Spread" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "scan" ;
        lv2:name "Scan" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "scan_mode" ;
        lv2:name "Scan mode" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Auto" ; rdf:value 0 ], [ rdfs:label "Manual" ; rdf:value 1 ]
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "routing" ;
        lv2:name "Routing" ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:default 0 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "In" ; rdf:value 0 ], [ rdfs:label "Feed" ; rdf:value 1 ], [ rdfs:label "Out" ; rdf:value 2 ]
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 16 ;
        lv2:symbol "collect" ;
        lv2:name "Collect" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty lv2:toggled
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 17 ;
        lv2:symbol "loop" ;
        lv2:name "Loop" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty lv2:toggled
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 18 ;
        lv2:symbol "latch" ;
        lv2:name "Latch" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty lv2:toggled
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 19 ;
        lv2:symbol "scan_hold" ;
        lv2:name "Scan hold" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty lv2:toggled
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 20 ;
        lv2:symbol "clear" ;
        lv2:name "Clear" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty lv2:toggled, pprops:trigger
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 21 ;
        lv2:symbol "memory_dry" ;
        lv2:name "Memory dry" ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:default 1 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ], [ rdfs:label "Scanning" ; rdf:value 1 ], [ rdfs:label "On" ; rdf:value 2 ]
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 22 ;
        lv2:symbol "wipe" ;
        lv2:name "Wipe" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty lv2:toggled
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 23 ;
        lv2:symbol "dry_kill" ;
        lv2:name "Dry kill" ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:default 0 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ], [ rdfs:label "Always" ; rdf:value 1 ], [ rdfs:label "Effect on" ; rdf:value 2 ]
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 24 ;
        lv2:symbol "always" ;
        lv2:name "Always rec" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty lv2:toggled
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 25 ;
        lv2:symbol "trails" ;
        lv2:name "Trails" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty lv2:toggled
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 26 ;
        lv2:symbol "pair" ;
        lv2:name "Pair" ;
        lv2:minimum 1 ;
        lv2:maximum 16 ;
        lv2:default 1 ;
        lv2:portProperty lv2:integer
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 27 ;
        lv2:symbol "enabled" ;
        lv2:name "On" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 1 ;
        lv2:portProperty lv2:toggled ;
        lv2:designation lv2:enabled
    ],
    [
        a lv2:InputPort, lv2:CVPort ;
        lv2:index 28 ;
        lv2:symbol "level_cv" ;
        lv2:name "Level CV" ;
        lv2:minimum -1 ;
        lv2:maximum 1 ;
        lv2:default 0
    ],
    [
        a lv2:InputPort, lv2:CVPort ;
        lv2:index 29 ;
        lv2:symbol "repeats_cv" ;
        lv2:name "Repeats CV" ;
        lv2:minimum -1 ;
        lv2:maximum 1 ;
        lv2:default 0
    ],
    [
        a lv2:InputPort, lv2:CVPort ;
        lv2:index 30 ;
        lv2:symbol "size_cv" ;
        lv2:name "Size CV" ;
        lv2:minimum -1 ;
        lv2:maximum 1 ;
        lv2:default 0
    ],
    [
        a lv2:InputPort, lv2:CVPort ;
        lv2:index 31 ;
        lv2:symbol "spread_cv" ;
        lv2:name "Spread CV" ;
        lv2:minimum -1 ;
        lv2:maximum 1 ;
        lv2:default 0
    ],
    [
        a lv2:InputPort, lv2:CVPort ;
        lv2:index 32 ;
        lv2:symbol "scan_cv" ;
        lv2:name "Scan CV" ;
        lv2:minimum -1 ;
        lv2:maximum 1 ;
        lv2:default 0
    ],
    [
        a lv2:OutputPort, lv2:CVPort ;
        lv2:index 33 ;
        lv2:symbol "clock" ;
        lv2:name "Size clock" ;
        lv2:minimum 0 ;
        lv2:maximum 1
    ],
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 34 ;
        lv2:symbol "paired" ;
        lv2:name "Paired" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 35 ;
        lv2:symbol "modifier" ;
        lv2:name "Modifier" ;
        lv2:minimum 0 ; lv2:maximum 4 ; lv2:default 0 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ],
                      [ rdfs:label "Stepped speed" ; rdf:value 1 ],
                      [ rdfs:label "Smooth speed" ; rdf:value 2 ],
                      [ rdfs:label "Trimmer" ; rdf:value 3 ],
                      [ rdfs:label "Dropper" ; rdf:value 4 ]
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 36 ;
        lv2:symbol "modify" ;
        lv2:name "Modify" ;
        lv2:minimum 0 ; lv2:maximum 1 ; lv2:default 0.5
    ],
    [
        a lv2:InputPort, lv2:CVPort ;
        lv2:index 37 ;
        lv2:symbol "modify_cv" ;
        lv2:name "Modify CV" ;
        lv2:minimum -1 ;
        lv2:maximum 1 ;
        lv2:default 0
    ] .
