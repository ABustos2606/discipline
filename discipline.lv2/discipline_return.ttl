@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix options: <http://lv2plug.in/ns/ext/options#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix bufsz: <http://lv2plug.in/ns/ext/buf-size#> .

<https://github.com/ABustos2606/discipline#return>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Discipline Return" ;
    doap:license <https://spdx.org/licenses/MIT> ;
    doap:maintainer [ foaf:name "Alejandro Bustos" ; foaf:homepage <https://github.com/ABustos2606> ] ;
    doap:homepage <https://github.com/ABustos2606/discipline> ;
    rdfs:comment "Brings the repeats from Discipline Send back in, when Discipline Modifier is Outside. One per patch; both plugins must run in the same host process." ;
    lv2:minorVersion 2 ;
    lv2:microVersion 0 ;
    lv2:optionalFeature lv2:hardRTCapable, options:options, urid:map ;
    options:supportedOption bufsz:nominalBlockLength, bufsz:maxBlockLength ;
    lv2:port
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "In L"
    ],
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "In R"
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "pair" ;
        lv2:name "Pair (unused)" ;
        rdfs:comment "Not used. Kept so older patches load." ;
        lv2:minimum 1 ;
        lv2:maximum 16 ;
        lv2:default 1 ;
        lv2:portProperty lv2:integer, pprops:notOnGUI
    ],
    [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "paired" ;
        lv2:name "Found" ;
        rdfs:comment "On while a Discipline with Modifier Outside is running." ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled
    ] .
